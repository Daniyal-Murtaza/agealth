# Brain
SUNDAY_PROVIDER=openai            # openai | fake (scripted, for the simulator and tests)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Telephony (only needed for real calls; the simulator works without it)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...          # your Twilio voice number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox or your approved sender
SUNDAY_PUBLIC_URL=https://your-tunnel.example.com   # where Twilio and the family reach this server

# Family web app: signs sign-in links and session cookies. Required for `sunday serve`.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUNDAY_SECRET_KEY=

# Storage and behaviour
SUNDAY_DB=./data/sunday.sqlite
SUNDAY_LOG_LEVEL=INFO
SUNDAY_MAX_CALL_MINUTES=12
